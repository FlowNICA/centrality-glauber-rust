// Configuration of the analysis steps: one section per executable in src/bin.
// Each executable reads only its own section, e.g. `fit config.ron` reads `fit`.
// Within a section, every field except the input files and names is optional
// and defaults to the value shown here. A leading "~/" in paths is expanded
// to $HOME. Options may be written without Some(...).
(
    // bin/fit: MC-Glauber multiplicity fit, port of config.c
    fit: (
        // Input file from MC-Glauber
        glauber_file: "~/glaub_new_auau_3gev_6M.root",
        glauber_tree: "glauber",

        // Input file with data multiplicity
        data_file: "~/star_mult_3gev_hist_500k.root",
        data_hist: "hRefMult",

        // Output directory
        out_dir: "./centrality-glauber-rust-check-likelihood/",

        // Number of iterations to find the optimal mu parameter
        n_iter: 20,

        // Parameters for the multiplicity fit
        f: (min: 0.9, max: 0.9, step: 0.01),
        k: (min: 0.5, max: 1.0, step: 0.1),
        p: (min: 0.002, max: 0.005, step: 0.001),

        // Fit range (bins of the data histogram)
        mult_min: 10,
        mult_max: 110,
        // ... or the fit range [fit_min, fit_max) in the units of the data (instead of
        // mult_min/mult_max), e.g. for an energy: the bins covering it are used
        // fit_min: 0.4,
        // fit_max: 28.0,

        // Statistic minimized to find the optimal parameters:
        //   Chi2       - minimum chi2 (as in the original framework)
        //   Likelihood - maximum Poisson likelihood, via -2 ln(L / L_saturated)
        fit_method: Likelihood,

        // Mode for the number of ancestors calculation
        //  |   mode    |   function for Na       |
        //  |  Default  | f*Npart + (1-f)*Ncoll   |
        //  |    PSD    |       f-Npart           |
        //  |   Npart   |       Npart^f           |
        //  |   Ncoll   |       Ncoll^f           |
        //  | NpartFast |    Npart^f / 10^f       |
        //  | NcollFast |    Ncoll^f / 100^f      |
        //  |   STAR    | (1-f)*Npart/2 + f*Ncoll |
        //  |   HADES   | (1 - f*Npart^2)*Npart   |
        mode: "Default",

        // Number of threads; omit to use all available cores
        // n_threads: 8,

        // Distribution of the multiplicity per ancestor (mean mu, variance mu*(1 + mu/k)),
        // used in the fit and for the per-ancestor output histogram:
        //   Gamma          - continuous Gamma distribution ("gamma" histogram)
        //   Nbd            - negative binomial distribution, integer values ("nbd" histogram)
        //   GammaScaleFree - Gamma with variance mu^2/k, for continuous observables such as
        //                    energy: the fit does not depend on their units ("gamma_scale_free")
        distribution: Nbd,

        // Random seed for reproducible results; omit for a random seed
        // seed: 42,
    ),

    // bin/define-centrality: centrality classes from the fit results,
    // port of HistoCut.C, CentralityClasses.C and printFinal.C
    centrality: (
        // QA file written by the fit (in the fit's out_dir)
        qa_file: "./centrality-glauber-rust-check-likelihood/glauber_qa.root",

        // Data multiplicity histogram; data_file defaults to qa_file, which
        // contains a copy of the fitted data histogram
        // data_file: "~/star_mult_3gev_hist_500k.root",
        data_hist: "hRefMult",

        // Output directory and name of the output ROOT file
        out_dir: "./centrality-glauber-rust-check-likelihood/",
        final_file: "FINAL.root",

        // Number of centrality classes of equal width in percent, or the class edges
        // in percent (increasing within [0, 100]; not both)
        n_classes: 10,
        // classes: [0, 5, 10, 20, 30, 40, 50, 60, 70, 80, 100],

        // Multiplicity bins entirely below min_value are not classified: 1 skips
        // events without hits; 0 for a continuous observable such as energy
        min_value: 1.0,

        // Table files written to out_dir in addition to the table on stdout:
        //   Tex - LaTeX document (<table_name>.tex)
        //   Csv - comma separated values (<table_name>.csv)
        //   Cpp - ROOT macro with arrays and GetCentMult(mult) (<table_name>.C)
        table_formats: [Csv, Cpp],
        table_name: "centrality_table",

        // PNG picture of the data, the fit, data / fit and the class borders in out_dir
        // (None: no picture), and the first line of its header
        plot_file: "centrality_result.png",
        // plot_title: "STAR, Au+Au 3 GeV",
    ),
)
