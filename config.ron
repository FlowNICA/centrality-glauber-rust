// Configuration of the analysis steps: one section per executable in src/bin.
// Each executable reads only its own section, e.g. `fit config.ron` reads `fit`.
// Within a section, every field except the input files and names is optional
// and defaults to the value shown here. A leading "~/" in paths is expanded
// to $HOME. Options may be written without Some(...).
(
    // bin/fit: MC-Glauber multiplicity fit, port of config.c
    fit: (
        // Input file from MC-Glauber
        glauber_file: "~/glaub_new_auau_3gev_6M.root",
        glauber_tree: "glauber",

        // Input file with data multiplicity
        data_file: "~/star_mult_3gev_hist_500k.root",
        data_hist: "hRefMult",

        // Output directory
        out_dir: "./centrality-glauber-rust-check-likelihood/",

        // Number of iterations to find the optimal mu parameter
        n_iter: 20,

        // Parameters for the multiplicity fit
        f: (min: 0.9, max: 0.9, step: 0.01),
        k: (min: 0.5, max: 1.0, step: 0.1),
        p: (min: 0.002, max: 0.005, step: 0.001),

        // Fit range (bins of the data histogram)
        mult_min: 10,
        mult_max: 110,

        // Statistic minimized to find the optimal parameters:
        //   Chi2       - minimum chi2 (as in the original framework)
        //   Likelihood - maximum Poisson likelihood, via -2 ln(L / L_saturated)
        fit_method: Likelihood,

        // Bin size of the Npart/Ncoll histograms
        bin_size: 1.0,

        // Mode for the number of ancestors calculation
        //  |   mode    |   function for Na       |
        //  |  Default  | f*Npart + (1-f)*Ncoll   |
        //  |    PSD    |       f-Npart           |
        //  |   Npart   |       Npart^f           |
        //  |   Ncoll   |       Ncoll^f           |
        //  | NpartFast |    Npart^f / 10^f       |
        //  | NcollFast |    Ncoll^f / 100^f      |
        //  |   STAR    | (1-f)*Npart/2 + f*Ncoll |
        //  |   HADES   | (1 - f*Npart^2)*Npart   |
        mode: "Default",

        // Number of threads; omit to use all available cores
        // n_threads: 8,

        // Name of the per-ancestor multiplicity histogram: Gamma ("gamma") or Nbd ("nbd").
        // The sampling is always Gamma, as in the original UseGamma()/UseNbd().
        distribution: Nbd,

        // Random seed for reproducible results; omit for a random seed
        // seed: 42,
    ),
)
